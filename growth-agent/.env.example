# Local store (never commit). Member emails stay here, not in git.
UAO_GROWTH_DB=growth-agent/private/uao_growth.db

# Weekly new-prospect target. This is outreach inventory, not auto-subscribe.
WEEKLY_QUOTA=10000
MIN_SENIORITY_SCORE=78
