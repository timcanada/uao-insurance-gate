# Official enrichment only. Leave blank to discover names/titles from
# public records without contacting anyone.
APOLLO_API_KEY=
NEVERBOUNCE_API_KEY=

# Optional: pull the live Ghost suppression list instead of a CSV drop.
GHOST_URL=https://www.universalassetowners.com
GHOST_ADMIN_API_KEY=

# Required by SEC.gov for EDGAR / IAPD requests.
